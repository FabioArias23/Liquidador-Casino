# ════════════════════════════════════════════════════════════════════════════════
# Liquidador de Casino — Variables de entorno
# ════════════════════════════════════════════════════════════════════════════════
# Copiá este archivo a `.env.local` y completá los valores.
#
# `.env.local`     NO se commitea (está en .gitignore — tiene secretos).
# `.env.example`   SÍ se commitea — es la referencia para el equipo.
#
# Convención: variables con prefijo `NEXT_PUBLIC_` se exponen al cliente.
# El resto son SERVER-ONLY — nunca las prefijés así.
# ════════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────────
# [DATA SOURCE] — qué backend usa la app
# ─────────────────────────────────────────────────────────────────────────────────
# "mock"     → in-memory con snapshot en .data/mock.json (default, ideal para dev).
# "drizzle"  → Postgres real via Drizzle ORM (Phase 5+, cuando Supabase esté listo).
DATA_SOURCE=mock

# ─────────────────────────────────────────────────────────────────────────────────
# [DATABASE] — Postgres (Supabase)
# ─────────────────────────────────────────────────────────────────────────────────
# Requerido SOLO si DATA_SOURCE=drizzle.
# Lo sacás de: Supabase → Project Settings → Database → Connection string
#              → "Transaction pooler" (recomendado para serverless) o "Direct".
# Formato:
#   postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=

# ─────────────────────────────────────────────────────────────────────────────────
# [SUPABASE] — auth + storage + realtime
# ─────────────────────────────────────────────────────────────────────────────────
# Requerido cuando se levante Supabase real (Phase 5).
# Los valores los sacás de: Supabase → Project Settings → API.
#
# Las `NEXT_PUBLIC_*` se exponen al cliente (son "publishable", no son secretos).
# Las otras son SERVER-ONLY — NUNCA las marques NEXT_PUBLIC.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER-ONLY. Bypasea RLS para operaciones admin del backoffice.
# NUNCA exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Para el CLI de Supabase (`supabase link`, migraciones, deploy de Edge Functions).
# Lo sacás de: Supabase → Project Settings → General → Reference ID.
SUPABASE_PROJECT_REF=

# ─────────────────────────────────────────────────────────────────────────────────
# [SEGURIDAD] — cifrado de credenciales del casino
# ─────────────────────────────────────────────────────────────────────────────────
# Key AES-GCM de 32 bytes (64 chars hex) usada para cifrar las API keys del casino
# en `casino_credentials.api_key_ciphertext` (ver PLAN-TECNICO §8).
#
# Generá UNA con:    openssl rand -hex 32
# NO commitees esta key. Si la perdés, todas las credenciales del casino
# dejan de poder descifrarse — hay que re-ingresarlas.
ENCRYPTION_KEY=

# ─────────────────────────────────────────────────────────────────────────────────
# [CASINO WEBHOOKS] — verificación de firma (Phase 4)
# ─────────────────────────────────────────────────────────────────────────────────
# Secret default para validar HMAC de webhooks entrantes del casino durante dev.
# En producción cada tenant tiene su propio secret en `casino_credentials.webhook_secret`
# (configurado vía UI en /backoffice/[slug]/casino).
# Generá UNA con:    openssl rand -hex 32
CASINO_WEBHOOK_SECRET_DEV=

# ─────────────────────────────────────────────────────────────────────────────────
# [MOCK] — comportamiento del in-memory store
# ─────────────────────────────────────────────────────────────────────────────────
# "false"  → NO persiste .data/mock.json al disco (útil para tests herméticos).
# default  → persiste (cambios sobreviven reinicios del dev server).
# MOCK_PERSIST=true

# ─────────────────────────────────────────────────────────────────────────────────
# [DEBUG] — flags de desarrollo
# ─────────────────────────────────────────────────────────────────────────────────
# Si está seteada, loggea info adicional cuando falla el optimistic lock en
# `asentar-carga` (útil para debug de race conditions).
# DEBUG_CARGAS=

# ─────────────────────────────────────────────────────────────────────────────────
# [APP] — Next.js estándar
# ─────────────────────────────────────────────────────────────────────────────────
# URL pública de la app. La usan los webhooks del casino para construir
# URLs de retorno, y los emails transaccionales (futuro).
# En dev: http://localhost:3000
# APP_URL=http://localhost:3000

# Estándar Next.js. Lo setea automáticamente `next dev` / `next start`.
# NODE_ENV=development
