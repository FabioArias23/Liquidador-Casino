# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
# NOTA de seguridad: .env.example TAMBIEN se ignora. Despues del incidente
# donde casi commiteamos un SUPABASE_SECRET_KEY en este archivo, decidimos
# ignorar hasta el archivo de referencia. Para saber que variables necesita
# el proyecto, ver docs/env-vars.md (o pedir al maintainer). Si necesitas
# agregar una var nueva, edita localmente + actualiza docs/env-vars.md.
.env.example

# mock data persistence (local only)
/.data/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
